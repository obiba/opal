<config xmlns='http://www.ehcache.org/v3'>

  <!-- not the folder of ehcache-shiro.xml: a persistence folder belongs to one cache manager -->
  <persistence directory="${OPAL_HOME}/work/ehcache-opal"/>

  <!-- entities of the views, so that a filtered view does not run its filter again after a restart -->
  <cache alias="magma-table-entities">
    <key-type>java.lang.String</key-type>
    <!-- read by reference from the heap, not copied at each count -->
    <value-type copier="org.ehcache.impl.copy.IdentityCopier">java.io.Serializable</value-type>
    <resources>
      <heap unit="entries">100</heap>
      <disk persistent="true" unit="GB">1</disk>
    </resources>
  </cache>

</config>
