<!-- Tests bind to logback rather than to the slf4j-nop that used to win on the test classpath, so
     without this the default BasicConfigurator would print every debug record the persistence tests
     produce. AbstractDatashieldLoggingTest restores this configuration after replacing it. -->
<configuration>

  <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%date - %-5level - %logger - %message%n</pattern>
    </encoder>
  </appender>

  <logger name="liquibase" level="warn"/>
  <logger name="org.hibernate" level="warn"/>

  <root level="info">
    <appender-ref ref="console"/>
  </root>

</configuration>
