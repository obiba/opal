# OBiBa/Opal systemd service file

[Unit]
Description=OBiBa Opal service
# Wait for network
After=network-online.target

[Service]
WorkingDirectory=/var/lib/opal
EnvironmentFile=/etc/default/opal
# Optional, and not shipped: for credentials that must not sit in the world readable file above,
# such as OTEL_EXPORTER_OTLP_HEADERS. systemd reads it as root, before dropping to User=, so it can
# be chmod 600 root:root and stay unreadable to the opal user.
EnvironmentFile=-/etc/default/opal-secrets
User=opal
LimitNOFILE=16384
StandardOutput=file:/var/log/opal/stdout.log
StandardError=file:/var/log/opal/stderr.log
ExecStart=/usr/share/opal/bin/start.sh

[Install]
WantedBy=multi-user.target
