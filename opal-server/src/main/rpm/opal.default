# Defaults for opal initscript
# sourced by /etc/init.d/opal
# installed at /etc/default/opal by the maintainer scripts

# pulled in from the init script; makes things easier.
NAME=opal

# location of java
JAVA=/usr/bin/java

# ulimit
# Increase maximum open files for the opal process
# Comment this out to use the system default
MAXOPENFILES=16384

# user id (or id:gid) to be run as
OPAL_USER=opal

# location of the opal distribution file
OPAL_DIST=/usr/share/opal

# Opal home location
OPAL_HOME=/var/lib/opal

# Opal log directory or syslog facility
OPAL_LOG=/var/log/opal

# arguments to pass to opal.
OPAL_ARGS=""

# arguments to pass to java
JAVA_ARGS="-Xms1G -Xmx2G -XX:+UseG1GC"
#
# OpenTelemetry
#
# Setting an OTLP endpoint is all that is needed: it turns on the audit log export, the DataSHIELD
# traces and the DataSHIELD metrics together. With no endpoint set, nothing is exported.
#
# Opal ships the OTLP/HTTP sender only, so this is the http/protobuf endpoint - port 4318 on a
# standard collector, not the 4317 gRPC port.
#
#OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example.org:4318

# Name reported to the backend. Defaults to "opal".
#OTEL_SERVICE_NAME=opal

# Extra resource attributes, e.g. to tell nodes apart in a federated study.
#OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production,service.namespace=my-node

# The DataSHIELD stream carries submitted R expressions, usernames and client addresses, so off
# localhost it needs TLS.
#OTEL_EXPORTER_OTLP_CERTIFICATE=/etc/opal/otel-ca.pem
#OTEL_EXPORTER_OTLP_CLIENT_CERTIFICATE=/etc/opal/otel-client.pem
#OTEL_EXPORTER_OTLP_CLIENT_KEY=/etc/opal/otel-client.key

# This file is world readable, so a collector token does NOT belong here. Put it in
# /etc/default/opal-secrets instead, which the service also reads and which can be chmod 600
# root:root - systemd reads it as root before dropping to the opal user:
#
#   echo 'OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20...' > /etc/default/opal-secrets
#   chmod 600 /etc/default/opal-secrets

# Metrics are exported every 60s by default; lower it while trying things out.
#OTEL_METRIC_EXPORT_INTERVAL=5000

# The OpenTelemetry Java agent adds the JDBC, Mongo and HTTP client calls made during a DataSHIELD
# operation, nested inside the DataSHIELD spans. Opal needs no change for this. Expect a warning that
# GlobalOpenTelemetry.set calls are ignored - that is normal - and note that the HTTP server spans
# stay in traces of their own: a DataSHIELD trace is rooted on the session, not on a request.
#   JAVA_ARGS="... -javaagent:/opt/opentelemetry-javaagent.jar"
