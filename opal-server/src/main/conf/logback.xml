<configuration>

  <!--hide verbose dependencies-->
  <logger name="jetty.util.log" level="error"/>

  <!--Uncomment the following line to see copy progress-->
  <!--<logger name="org.obiba.magma.support.DatasourceCopier" level="debug"/>-->

  <!--dev-->
  <!--<logger name="org.obiba" level="debug"/>-->
  <!--<logger name="org.obiba.magma.security" level="info"/>-->
  <!--<logger name="org.obiba.opal.web.security" level="info"/>-->
  <!--<logger name="org.obiba.opal.server.httpd" level="info"/>-->
  <!--<logger name="org.obiba.opal.search.IndexSynchronizationManager" level="info"/>-->

  <contextListener class="ch.qos.logback.classic.jul.LevelChangePropagator">
    <resetJUL>true</resetJUL>
  </contextListener>

  <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>ERROR</level>
    </filter>
    <encoder>
      <pattern>%date %-5level %logger - %message%n</pattern>
    </encoder>
  </appender>

  <appender name="opal" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${OPAL_LOG}/opal.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
      <fileNamePattern>${OPAL_LOG}/opal-%i.log</fileNamePattern>
      <maxIndex>10</maxIndex>
    </rollingPolicy>
    <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
      <maxFileSize>10MB</maxFileSize>
    </triggeringPolicy>
    <encoder>
      <pattern>%date [%thread] %-5level %logger - %message%n</pattern>
    </encoder>
  </appender>

  <appender name="datashield" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${OPAL_LOG}/datashield.log</file>
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>INFO</level>
    </filter>
    <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
      <fileNamePattern>${OPAL_LOG}/datashield-%i.log</fileNamePattern>
      <maxIndex>10</maxIndex>
    </rollingPolicy>
    <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
      <maxFileSize>10MB</maxFileSize>
    </triggeringPolicy>
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <excludeMdcKeyName>method</excludeMdcKeyName>
      <excludeMdcKeyName>created</excludeMdcKeyName>
    </encoder>
  </appender>

  <appender name="rest" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${OPAL_LOG}/rest.log</file>
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>INFO</level>
    </filter>
    <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
      <fileNamePattern>${OPAL_LOG}/rest-%i.log</fileNamePattern>
      <maxIndex>10</maxIndex>
    </rollingPolicy>
    <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
      <maxFileSize>10MB</maxFileSize>
    </triggeringPolicy>
    <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
    <!--encoder>
      <pattern>%date - %level - %X{username} - %X{status} - %X{method} - %message - %X{created}%n</pattern>
    </encoder-->
  </appender>

  <appender name="sql" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${OPAL_LOG}/sql.log</file>
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>INFO</level>
    </filter>
    <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
      <fileNamePattern>${OPAL_LOG}/sql-%i.log</fileNamePattern>
      <maxIndex>10</maxIndex>
    </rollingPolicy>
    <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
      <maxFileSize>10MB</maxFileSize>
    </triggeringPolicy>
    <encoder>
      <pattern>%message%n</pattern>
    </encoder>
  </appender>


  <!--
    OpenTelemetry export. These appenders are inert unless an OTLP endpoint is configured: OpalServer
    installs a no-op OpenTelemetry into them when there is none, so they allocate nothing and buffer
    nothing. To turn export on, set the standard OTEL_* environment variables before starting Opal -
    at minimum OTEL_EXPORTER_OTLP_ENDPOINT (or OTEL_EXPORTER_OTLP_LOGS_ENDPOINT). The same variable
    also enables the DataSHIELD traces and metrics, which are produced in code rather than here.

    Endpoint, protocol, headers, TLS and resource attributes are NOT configured here: they belong to
    the SDK, not to an appender, and the appender has no such properties.

    SECURING THE ENDPOINT. The DataSHIELD stream below carries the submitted R expressions, the
    usernames and the client addresses, so it is as sensitive as datashield.log but, unlike it,
    leaves the host. Keep the collector inside the node's trust boundary and use an authenticated,
    encrypted endpoint:

      OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example.org:4318   (https, not http)
      OTEL_EXPORTER_OTLP_CERTIFICATE=/path/ca.pem                      trusted CA for the collector
      OTEL_EXPORTER_OTLP_CLIENT_CERTIFICATE=/path/client.pem           client cert, for mTLS
      OTEL_EXPORTER_OTLP_CLIENT_KEY=/path/client.key                   client key, for mTLS
      OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20...            if the collector wants a token

    A plaintext http:// endpoint sends R scripts and usernames in the clear; only use one when the
    collector is on localhost. On deb/rpm, keep the token out of the world-readable
    /etc/default/opal and put it in /etc/default/opal-secrets, which systemd reads as root.

    There is no per-appender service.name: one JVM is one service. Use the instrumentation scope,
    which is the logger name (datashield.user, datashield.admin, ...), to tell the streams apart.
  -->

  <appender name="otel" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
    <captureExperimentalAttributes>false</captureExperimentalAttributes>
    <captureMdcAttributes>ip,username</captureMdcAttributes>
    <numLogsCapturedBeforeOtelInstall>2000</numLogsCapturedBeforeOtelInstall>
  </appender>

  <appender name="otelrest" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
    <captureExperimentalAttributes>false</captureExperimentalAttributes>
    <captureMdcAttributes>ip,username,status,method</captureMdcAttributes>
    <numLogsCapturedBeforeOtelInstall>2000</numLogsCapturedBeforeOtelInstall>
  </appender>

  <!-- DataSHIELD audit logs. The MDC keys are NOT renamed at the source: datashield.log is parsed
       by external tooling and its field names must not change. Instead otelds rewrites the MDC map
       on its way to otelraw only, so the file appender above is unaffected. -->
  <appender name="otelraw" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
    <captureExperimentalAttributes>false</captureExperimentalAttributes>
    <captureMdcAttributes>*</captureMdcAttributes>
    <numLogsCapturedBeforeOtelInstall>2000</numLogsCapturedBeforeOtelInstall>
  </appender>

  <appender name="otelds" class="org.obiba.opal.core.logging.MdcRenamingAppender">
    <rename>ds_id=datashield.session.id</rename>
    <rename>ds_profile=datashield.profile</rename>
    <rename>ds_action=datashield.action</rename>
    <rename>ds_symbol=datashield.symbol</rename>
    <rename>ds_eval=datashield.script</rename>
    <!-- set by AbstractRestrictedRScriptROperation when the submitted expression is parsed -->
    <rename>ds_script_in=datashield.script.submitted</rename>
    <rename>ds_script_out=datashield.script.generated</rename>
    <rename>ds_map=datashield.script.mapping</rename>
    <rename>username=enduser.id</rename>
    <rename>ip=client.address</rename>
    <!-- ds_eval carries the submitted R expression, exported in full as datashield.script: it is the
         substance of the DataSHIELD security audit trail, since disclosure attempts show up in the
         expression itself. This makes the collector a processor of sensitive content - see SECURING
         THE ENDPOINT above. <truncate>ds_eval=512</truncate> caps the value if payload size ever
         becomes a problem, at the cost of truncating audit evidence. -->
    <appender-ref ref="otelraw"/>
  </appender>

  <!-- additivity=false prevents propagation to root; both the file and the OTel branch receive events -->
  <logger name="datashield" additivity="false" level="info">
    <appender-ref ref="datashield"/>
    <appender-ref ref="otelds"/>
  </logger>

  <logger name="org.obiba.opal.web.security.AuditInterceptor" additivity="false" level="info">
    <appender-ref ref="rest"/>
    <appender-ref ref="otelrest"/>
  </logger>

  <logger name="sql" additivity="false" level="info">
    <appender-ref ref="sql"/>
  </logger>

  <root level="info">
    <appender-ref ref="console"/>
    <appender-ref ref="opal"/>
    <appender-ref ref="otel"/>
  </root>

</configuration>